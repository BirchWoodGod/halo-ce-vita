# systemd unit for halo-relay (README.md). Install:
#   sudo install -m 755 halo-relay /usr/local/bin/halo-relay
#   sudo install -m 644 halo-relay.service /etc/systemd/system/halo-relay.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now halo-relay
# Then open UDP 47320 in the firewall (and forward it on the router, for a
# machine at home). Logs: journalctl -u halo-relay
[Unit]
Description=Halo CE for PS Vita internet play relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/halo-relay --port 47320 --allocations 256 --per-address 16 --rate-kbit 4000 --total-mbit 50
Restart=on-failure
RestartSec=5
# (no state on disk, no privileges: a user of its own each start)
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
MemoryMax=64M
TasksMax=4

[Install]
WantedBy=multi-user.target
