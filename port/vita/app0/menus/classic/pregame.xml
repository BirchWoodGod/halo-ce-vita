<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Halo CE: the Xbox's network pregame (the game's lobby: connected_pregame_screen) with
     the port's buttons said under the Xbox's own: Y PLAYERS (menu_functions.c's Triangle in the game's
     lobby, either Menu style) and the right trigger, LOBBY OPTIONS: a screen in the look of OpenCE's
     Server Setup (setup.xml) with PLAYERS (the players' options: add friend, mute chat, the host's
     kick and ban - halo3/players.xml), the host's INVITE FRIENDS (a game hosted online:
     halo3/party.xml's invite screen) and MAP VARIANT (the hosted map's Forge variants, none first,
     each press the next: the joiners asked to play it, as the Halo 3 lobby's MAP picker does); a
     joined machine's has PLAYERS alone (port ce lobby) -->
<menus>
	<strings name="ce/lobby_labels">
		<string text="LOBBY OPTIONS"/>
		<string text="PLAYERS"/>
		<string text="INVITE FRIENDS"/>
		<string text="MAP VARIANT"/>
		<string text="%y-button PLAYERS   %right-trigger LOBBY OPTIONS"/>
	</strings>
	<strings name="ce/lobby_help">
		<string text="The players in this game: add one as a\nfriend, mute their chat; the host kicks\nor bans."/>
		<string text="Your friends online: invite them into\nthis game."/>
		<string text="Play one of your Forge map variants of\nthis map (FORGE, then FILE SHARE): each\n%a-button the next, then NONE."/>
	</strings>
	<!-- (the port's functions run from widgets of ours alone - ui_widget_function_denied -: the
	     pregame's own, the map's, opens the screen and no more) -->
	<widget name="ce/pregame/buttons" type="text" left="80" top="442" width="540" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/lobby_labels" string_index="4" text_flags="no_focus_test">
		<on event="created" run="port ce pregame init"/>
	</widget>
	<widget name="ce/pregame/screen" extends="ui\shell\main_menu\multiplayer_type_select\connected\pregame\connected_pregame_screen" classic_patch="true">
		<on event="right_trigger" open="ce/lobby/screen"/>
		<child widget="ce/pregame/buttons"/>
	</widget>

	<widget name="ce/lobby/title" type="text" left="54" top="30" width="520" height="30" font="ui\large_ui" color="#FF2896FF" string_list="ce/lobby_labels" string_index="0"/>
	<widget name="ce/lobby/players_label" string_list="ce/lobby_labels" string_index="1" type="text" width="300" height="22" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="4"/>
	<widget name="ce/lobby/op_players" width="512" height="28" flags="pass_unhandled_to_focused_child" bitmap="option_bkds" color="#FF2896FF">
		<on event="a start" open="h3/players/screen"/>
		<child widget="ce/lobby/players_label"/>
	</widget>
	<widget name="ce/lobby/invite_label" string_list="ce/lobby_labels" string_index="2" type="text" width="300" height="22" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="4"/>
	<widget name="ce/lobby/op_invite" width="512" height="28" flags="pass_unhandled_to_focused_child" bitmap="option_bkds" color="#FF2896FF">
		<on event="a start" run="port h3 invite ask" open="h3/invite/screen"/>
		<child widget="ce/lobby/invite_label"/>
	</widget>
	<widget name="ce/lobby/variant_label" string_list="ce/lobby_labels" string_index="3" type="text" width="230" height="22" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="4"/>
	<widget name="ce/lobby/variant_value" type="text" width="280" height="22" font="ui\small_ui" color="#FF2896FF" align="center" text_y="5" text_flags="no_focus_test"/>
	<widget name="ce/lobby/op_variant" width="512" height="28" flags="pass_unhandled_to_focused_child" bitmap="option_bkds" color="#FF2896FF">
		<on event="a start" run="port ce variant next"/>
		<child widget="ce/lobby/variant_label"/>
		<child widget="ce/lobby/variant_value" x="230" y="1"/>
	</widget>
	<widget name="ce/lobby/lobby_help" type="text" left="68" top="190" width="520" height="80" string_list="ce/lobby_help" font="ui\large_ui" color="#FFFFFFFF"/>
	<widget name="ce/lobby/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port ce lobby"/>
		<child widget="ce/lobby/op_players" x="54" y="80"/>
		<child widget="ce/lobby/op_invite" x="54" y="106"/>
		<child widget="ce/lobby/op_variant" x="54" y="132"/>
	</widget>
	<widget name="ce/lobby/screen" flags="pass_unhandled_to_focused_child" bitmap="gradient">
		<child widget="ce/lobby/title"/>
		<child widget="ce/lobby/list"/>
		<child widget="ce/lobby/lobby_help"/>
		<child widget="ui\shell\main_menu\button_key"/>
	</widget>
</menus>
