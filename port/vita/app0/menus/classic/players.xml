		<child widget="cp/players/a_label"/>
	</widget>

	<!-- a player's options: the rows at the left (BACK first; those that do not apply hidden), the player
	     and what they are in the field -->
	<widget name="cp/players/option_back" type="text" width="226" height="32" bitmap="cp/players/art_list_item_bkd_top" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="5" string_list="h3/players_text" string_index="13">
		<on event="a" back="true"/>
	</widget>
	<widget name="cp/players/option_add" type="text" width="226" height="32" bitmap="cp/players/art_list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="5" string_list="h3/players_text" string_index="6">
