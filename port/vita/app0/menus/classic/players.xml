	</bitmap>
	<widget name="cp/players/header" left="35" top="11" width="512" height="64" bitmap="cp/players/header_art"/>
	<widget name="cp/players/players_status" type="text" left="24" top="336" width="592" height="20" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/players/header_name" type="text" left="32" top="82" width="250" height="16" font="ui\small_ui" color="#FFCCCCCC" text_flags="no_focus_test" string_list="h3/players_text" string_index="1"/>
	<widget name="cp/players/header_team" type="text" left="330" top="82" width="120" height="16" font="ui\small_ui" color="#FFCCCCCC" text_flags="no_focus_test" string_list="h3/players_text" string_index="2"/>
	<widget name="cp/players/header_friend" type="text" left="470" top="82" width="140" height="16" font="ui\small_ui" color="#FFCCCCCC" text_flags="no_focus_test" string_list="h3/players_text" string_index="3"/>
