<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Classic+: PLAYERS (a game's pause, the pregame's LOBBY OPTIONS) in the original menus' look,
     standing for the Halo 3 set's (a cp/<name> widget for h3/<name>: menu_tags.c, the classic set); read with
     the menus and with a level's (ingame.txt). Written by tools/classic_standins_xml.py, which says how it is
     laid out. -->
<menus>
	<bitmap name="cp/players/art_gradient" resource="ui\shell\bitmaps\gradient"/>
	<bitmap name="cp/players/art_semi_transparent_grey" resource="ui\shell\bitmaps\semi_transparent_grey"/>
	<bitmap name="cp/players/art_list_item_bkd" resource="ui\shell\bitmaps\list_item_bkd"/>
	<bitmap name="cp/players/art_list_item_bkd_top" resource="ui\shell\bitmaps\list_item_bkd_top"/>
	<bitmap name="cp/players/art_list_field" resource="ui\shell\bitmaps\list_field"/>
	<bitmap name="cp/players/art_server_item_bkds" resource="ui\shell\bitmaps\server_item_bkds"/>
	<bitmap name="cp/players/art_blue" resource="ui\shell\bitmaps\blue"/>
	<bitmap name="cp/players/art_a_butn" resource="ui\shell\bitmaps\a_butn"/>
	<bitmap name="cp/players/art_b_butn" resource="ui\shell\bitmaps\b_butn"/>
	<strings name="cp/players_keys">
		<string text="=BACK"/>
		<string text="=SELECT"/>
		<string text="=OPTIONS"/>
	</strings>

	<!-- PLAYERS (a game's pause, the pregame's LOBBY OPTIONS): the players on the server browser's rows
