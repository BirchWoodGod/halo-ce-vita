	<widget name="cp/forge/packs/info_name" type="text" left="315" top="92" width="290" height="22" font="ui\large_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/forge/packs/info_text" type="text" left="315" top="118" width="290" height="120" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/forge/packs/info_state" type="text" left="315" top="244" width="290" height="80" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
