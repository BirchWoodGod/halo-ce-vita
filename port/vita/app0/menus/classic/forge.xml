	<widget name="cp/forge/maps/item_6" type="text" left="51" width="254" height="24" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_7" type="text" left="51" width="254" height="24" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_8" type="text" left="51" width="254" height="24" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_9" type="text" left="51" width="254" height="24" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_10" type="text" left="51" width="254" height="24" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_11" type="text" left="51" width="254" height="24" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_12" type="text" left="51" width="254" height="24" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port forge map focus"/>
		<on event="left_trigger" run="port forge variant page up"/>
		<on event="right_trigger" run="port forge variant page down"/>
		<data input="port forge maps"/>
		<child widget="cp/forge/maps/item_0" y="80"/>
		<child widget="cp/forge/maps/item_1" y="104"/>
		<child widget="cp/forge/maps/item_2" y="128"/>
		<child widget="cp/forge/maps/item_3" y="152"/>
		<child widget="cp/forge/maps/item_4" y="176"/>
		<child widget="cp/forge/maps/item_5" y="200"/>
		<child widget="cp/forge/maps/item_6" y="224"/>
		<child widget="cp/forge/maps/item_7" y="248"/>
