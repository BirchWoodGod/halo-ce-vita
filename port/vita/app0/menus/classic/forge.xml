	</widget>
	<widget name="cp/forge/maps/maps_picture" left="315" top="92" width="140" height="114" bitmap="ui\shell\bitmaps\mp_map_grafix"/>
	<widget name="cp/forge/maps/maps_text" type="text" left="315" top="216" width="290" height="170" font="ui\small_ui" color="#FF2896FF" string_list="ui\shell\main_menu\multiplayer_type_select\mp_map_select\map_data"/>
	<widget name="cp/forge/maps/variant_name" type="text" left="315" top="216" width="290" height="22" font="ui\large_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/forge/maps/variant_text" type="text" left="315" top="240" width="290" height="140" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/forge/maps/description" left="300" top="78" width="320" height="322" bitmap="list_field">
		<child widget="cp/forge/maps/maps_picture"/>
		<child widget="cp/forge/maps/maps_text"/>
		<child widget="cp/forge/maps/variant_name"/>
		<child widget="cp/forge/maps/variant_text"/>
	</widget>
	<widget name="cp/forge/maps/screen" flags="pass_unhandled_to_focused_child" bitmap="gradient">
		<on event="b back" run="port forge maps back" back="true"/>
		<child widget="cp/forge/maps/title"/>
		<child widget="cp/forge/maps/description"/>
		<child widget="cp/forge/maps/list"/>
		<child widget="ui\shell\main_menu\button_key"/>
	</widget>

	<!-- EXTRA OBJECTS: the scene packs Forge brings (port forge packs: A turns one on or off) -->
	<widget name="cp/forge/packs/header" left="35" top="11" width="512" height="64" bitmap="cp/forge/packs_header_art"/>
	<widget name="cp/forge/packs/item_0" type="text" left="51" width="254" height="32" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="5">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="cp/forge/packs/item_1" type="text" left="51" width="254" height="32" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="5">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="cp/forge/packs/item_2" type="text" left="51" width="254" height="32" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="5">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="cp/forge/packs/item_3" type="text" left="51" width="254" height="32" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="5">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="cp/forge/packs/item_4" type="text" left="51" width="254" height="32" bitmap="list_item_bkd" font="ui\large_ui" color="#FF2896FF" text_x="13" text_y="5">
