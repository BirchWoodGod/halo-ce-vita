		<child widget="cp/forge/maps/row_name"/>
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_6" left="0" width="224" height="24" bitmap="list_item_bkd">
		<child widget="cp/forge/maps/row_name"/>
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_7" left="0" width="224" height="24" bitmap="list_item_bkd">
		<child widget="cp/forge/maps/row_name"/>
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_8" left="0" width="224" height="24" bitmap="list_item_bkd">
		<child widget="cp/forge/maps/row_name"/>
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_9" left="0" width="224" height="24" bitmap="list_item_bkd">
		<child widget="cp/forge/maps/row_name"/>
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_10" left="0" width="224" height="24" bitmap="list_item_bkd">
		<child widget="cp/forge/maps/row_name"/>
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_11" left="0" width="224" height="24" bitmap="list_item_bkd">
		<child widget="cp/forge/maps/row_name"/>
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/item_12" left="0" width="224" height="24" bitmap="list_item_bkd">
		<child widget="cp/forge/maps/row_name"/>
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="cp/forge/maps/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port forge map focus"/>
		<on event="left_trigger" run="port forge variant page up"/>
		<on event="right_trigger" run="port forge variant page down"/>
		<data input="port forge maps"/>
		<child widget="cp/forge/maps/item_0" x="51" y="78"/>
		<child widget="cp/forge/maps/item_1" x="51" y="102"/>
		<child widget="cp/forge/maps/item_2" x="51" y="126"/>
		<child widget="cp/forge/maps/item_3" x="51" y="150"/>
		<child widget="cp/forge/maps/item_4" x="51" y="174"/>
		<child widget="cp/forge/maps/item_5" x="51" y="198"/>
		<child widget="cp/forge/maps/item_6" x="51" y="222"/>
		<child widget="cp/forge/maps/item_7" x="51" y="246"/>
		<child widget="cp/forge/maps/item_8" x="51" y="270"/>
		<child widget="cp/forge/maps/item_9" x="51" y="294"/>
		<child widget="cp/forge/maps/item_10" x="51" y="318"/>
		<child widget="cp/forge/maps/item_11" x="51" y="342"/>
		<child widget="cp/forge/maps/item_12" x="51" y="366"/>
	</widget>
	<widget name="cp/forge/maps/maps_picture" left="290" top="92" width="140" height="114" bitmap="ui\shell\bitmaps\mp_map_grafix"/>
	<widget name="cp/forge/maps/maps_text" type="text" left="290" top="216" width="290" height="170" font="ui\small_ui" color="#FF2896FF" string_list="ui\shell\main_menu\multiplayer_type_select\mp_map_select\map_data"/>
	<widget name="cp/forge/maps/variant_name" type="text" left="290" top="216" width="290" height="22" font="ui\large_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/forge/maps/variant_text" type="text" left="290" top="240" width="290" height="140" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="cp/forge/maps/description" left="275" top="78" width="320" height="322" bitmap="list_field">
		<child widget="cp/forge/maps/maps_picture"/>
		<child widget="cp/forge/maps/maps_text"/>
		<child widget="cp/forge/maps/variant_name"/>
		<child widget="cp/forge/maps/variant_text"/>
	</widget>
	<widget name="cp/forge/maps/screen" flags="pass_unhandled_to_focused_child" bitmap="gradient">
		<on event="b back" run="port forge maps back" back="true"/>
		<child widget="cp/forge/maps/header"/>
		<child widget="cp/forge/maps/description"/>
		<child widget="cp/forge/maps/list"/>
		<child widget="cp/key/b_butn"/>
		<child widget="cp/key/back"/>
		<child widget="cp/key/a_butn"/>
		<child widget="cp/key/select"/>
	</widget>

	<!-- EXTRA OBJECTS: the scene packs Forge brings (port forge packs: A turns one on or off), on the
	     settings rows of CUSTOMIZATION and the game type editor (the pack at the left, ON or OFF at the right:
	     menu_functions.c's text_show splits "PACK: ON"), the chosen one's words under them -->
	<widget name="cp/forge/packs/header" left="35" top="11" width="512" height="64" bitmap="cp/forge/packs_header_art"/>
	<widget name="cp/forge/packs/label" type="text" left="0" top="0" width="270" height="17" font="ui\small_ui" color="#FF2896FF" text_x="44" text_y="1"/>
	<widget name="cp/forge/packs/value" type="text" left="291" top="0" width="220" height="17" align="center" font="ui\small_ui" color="#FF2896FF" text_y="1" text_flags="no_focus_test"/>
	<widget name="cp/forge/packs/item_0" width="600" height="17" flags="pass_unhandled_to_focused_child" bitmap="server_item_bkds" color="#FF2896FF">
		<on event="a" run="port forge pack toggle"/>
		<child widget="cp/forge/packs/label"/>
		<child widget="cp/forge/packs/value"/>
	</widget>
	<widget name="cp/forge/packs/item_1" width="600" height="17" flags="pass_unhandled_to_focused_child" bitmap="server_item_bkds" color="#FF2896FF">
		<on event="a" run="port forge pack toggle"/>
		<child widget="cp/forge/packs/label"/>
		<child widget="cp/forge/packs/value"/>
	</widget>
	<widget name="cp/forge/packs/item_2" width="600" height="17" flags="pass_unhandled_to_focused_child" bitmap="server_item_bkds" color="#FF2896FF">
		<on event="a" run="port forge pack toggle"/>
		<child widget="cp/forge/packs/label"/>
		<child widget="cp/forge/packs/value"/>
	</widget>
	<widget name="cp/forge/packs/item_3" width="600" height="17" flags="pass_unhandled_to_focused_child" bitmap="server_item_bkds" color="#FF2896FF">
		<on event="a" run="port forge pack toggle"/>
		<child widget="cp/forge/packs/label"/>
		<child widget="cp/forge/packs/value"/>
	</widget>
	<widget name="cp/forge/packs/item_4" width="600" height="17" flags="pass_unhandled_to_focused_child" bitmap="server_item_bkds" color="#FF2896FF">
		<on event="a" run="port forge pack toggle"/>
		<child widget="cp/forge/packs/label"/>
		<child widget="cp/forge/packs/value"/>
	</widget>
	<widget name="cp/forge/packs/item_5" width="600" height="17" flags="pass_unhandled_to_focused_child" bitmap="server_item_bkds" color="#FF2896FF">
		<on event="a" run="port forge pack toggle"/>
		<child widget="cp/forge/packs/label"/>
		<child widget="cp/forge/packs/value"/>
	</widget>
	<widget name="cp/forge/packs/item_6" width="600" height="17" flags="pass_unhandled_to_focused_child" bitmap="server_item_bkds" color="#FF2896FF">
		<on event="a" run="port forge pack toggle"/>
		<child widget="cp/forge/packs/label"/>
		<child widget="cp/forge/packs/value"/>
	</widget>
	<widget name="cp/forge/packs/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port forge packs"/>
		<child widget="cp/forge/packs/item_0" x="20" y="100"/>
		<child widget="cp/forge/packs/item_1" x="20" y="119"/>
		<child widget="cp/forge/packs/item_2" x="20" y="138"/>
		<child widget="cp/forge/packs/item_3" x="20" y="157"/>
		<child widget="cp/forge/packs/item_4" x="20" y="176"/>
