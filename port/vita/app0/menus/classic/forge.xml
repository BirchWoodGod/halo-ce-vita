	</widget>
	<widget name="cp/forge/packs/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port forge packs"/>
		<child widget="cp/forge/packs/item_0" y="92"/>
		<child widget="cp/forge/packs/item_1" y="125"/>
		<child widget="cp/forge/packs/item_2" y="158"/>
		<child widget="cp/forge/packs/item_3" y="191"/>
