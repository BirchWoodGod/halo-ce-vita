<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Classic+: File Share with friends (port/linux/src/p2p_fileshare.h;
     docs/fileshare-friends.md) in the look of the Xbox's list screens: a cp/<name> screen stands for
     halo3/fileshare_friends.xml's h3/<name> (menu_tags.c's classic set), its rows and texts named as
     those are, so menu_functions.c's "port fileshare share ...", "port fileshare send ..." and "port
     fileshare friend ..." fill them alike: SHARING (Start on a file of FILE SHARE), SEND TO A FRIEND,
     a friend's FILE SHARE (FRIENDS, Triangle on a friend online) and its DOWNLOAD? question. ui.map's
     gradient, list_item_bkd rows, list_field, alert_bkd and fonts (tag paths: the player's
     ui.map's); the headings are text in its large_ui font. No Bungie picture or line of text here. -->
<menus>
	<strings name="cp/fsfriends_text">
		<string text="SHARING"/>
		<string text="SEND TO A FRIEND"/>
		<string text="%a-button SEND"/>
		<string text="%a-button DOWNLOAD"/>
		<string text="%y-button ASK AGAIN"/>
		<string text="DOWNLOAD?"/>
		<string text="%a-button SELECT   %b-button BACK"/>
		<string text="%a-button DOWNLOAD   %b-button CANCEL"/>
		<string text="%b-button BACK"/>
		<string text="BACK"/>
	</strings>

