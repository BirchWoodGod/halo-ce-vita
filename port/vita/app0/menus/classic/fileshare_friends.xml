	</bitmap>
	<widget name="cp/fileshare/header/send" left="35" top="11" width="512" height="64" bitmap="cp/fileshare/header/send_art"/>
	<bitmap name="cp/fileshare/header/file_share_art">
		<frame png="classic/{lang}/header_file_share.png" width="512" height="64"/>
	</bitmap>
	<widget name="cp/fileshare/header/file_share" left="35" top="11" width="512" height="64" bitmap="cp/fileshare/header/file_share_art"/>
