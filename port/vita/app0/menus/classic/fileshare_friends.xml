<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Classic+: File Share with friends (port/linux/src/p2p_fileshare.h;
     docs/fileshare-friends.md) in the look of the original menus: a cp/<name> screen stands for
     halo3/fileshare_friends.xml's h3/<name> (menu_tags.c's classic set), its rows and texts named as
     those are, so menu_functions.c's "port fileshare share ...", "port fileshare send ..." and "port
     fileshare friend ..." fill them alike. SHARING (Start on a file of FILE SHARE) and SEND TO A
     FRIEND as FRIENDS and its options are (classic/friends.xml: the heading at 35,11, the list of
     list_item_bkd rows at the left in small_ui, the description's list_field at the right, the
     button key along the foot); a friend's FILE SHARE as FILE SHARE is (classic/fileshare.xml: rows
     across the screen on server_item_bkds, the chosen one's picture and details under them); its
     DOWNLOAD? question as FILE SHARE's DELETE MAP VARIANT? is (alert_bkd's box). ui.map's pictures
     and fonts (tag paths: the player's ui.map's); the headings are the port's own words drawn in the
     Multiplayer screens' look (tools/classic_menu_art.py, classic/<lang>/header_*.png). No Bungie
     picture or line of text here. -->
<menus>
	<strings name="cp/fsfriends_text">
		<string text="BACK"/>
		<string text="=SELECT"/>
		<string text="=BACK"/>
		<string text="=SEND"/>
		<string text="=DOWNLOAD"/>
		<string text="=ASK AGAIN"/>
		<string text="DOWNLOAD?"/>
		<string text="%a-button =DOWNLOAD   %b-button =CANCEL"/>
	</strings>
	<bitmap name="cp/fileshare/header/sharing_art">
		<frame png="classic/{lang}/header_sharing.png" width="512" height="64"/>
	</bitmap>
	<widget name="cp/fileshare/header/sharing" left="35" top="11" width="512" height="64" bitmap="cp/fileshare/header/sharing_art"/>
	<bitmap name="cp/fileshare/header/send_art">
