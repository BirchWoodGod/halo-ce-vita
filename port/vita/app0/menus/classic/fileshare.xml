<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Halo CE: FILE SHARE (the main menu's FILE SHARE row, classic/main.xml) in the look of
     the original menus' list of games (Halo PC's server browser: rows across the screen on its
     server_item_bkds in ui.map's small_ui, the focused one's box closed on all four sides), so a map
     variant's name of the most letters it may have (31) is shown whole: ui.map's gradient, the
     heading at 35,11 (words drawn in the look of the game's headings: tools/classic_menu_art.py,
     classic/<lang>/), the kind (MAP VARIANTS or GAME VARIANTS: left and right, the spinners' arrows)
     and the count over the rows, the chosen one's map picture (ui.map's mp_map_grafix), name and
     details under them, the button key at the foot as the Xbox's (the key, "=" and the word in
     large_ui). Every function is Halo 3's File Share's (halo3/fileshare.xml, menu_functions.c's port
     fileshare: the widgets found by their last name - row_<n>'s row_name and row_map, kind, count,
     picture, info_name, info_text, status, open, rename, delete); only the look is this file's. No
     picture or line of text of Bungie's here: the pictures and fonts are the player's ui.map's and
     bitmaps.map's (art.xml), read as the menus load -->
<menus>
	<bitmap name="ce/fileshare/header_art">
		<frame png="classic/{lang}/header_file_share.png" width="512" height="64"/>
	</bitmap>
	<strings name="ce/fileshare_text">
		<string text="=SELECT"/>
		<string text="=RENAME"/>
		<string text="=DELETE"/>
		<string text="=BACK"/>
		<string text="KIND"/>
		<string text="DELETE MAP VARIANT?"/>
		<string text="%a-button =DELETE   %b-button =CANCEL"/>
	</strings>

	<!-- the rows: eight shown (they scroll: port fileshare counts them), each the name as it was
	typed and its map, the focused one's box lit -->
	<widget name="ce/fileshare/row_name" type="text" left="12" top="1" width="380" height="16" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/row_map" type="text" left="400" top="1" width="188" height="16" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/row_0" width="600" height="17" bitmap="server_item_bkds">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="ce/fileshare/row_name"/>
		<child widget="ce/fileshare/row_map"/>
	</widget>
	<widget name="ce/fileshare/row_1" width="600" height="17" bitmap="server_item_bkds">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="ce/fileshare/row_name"/>
		<child widget="ce/fileshare/row_map"/>
	</widget>
	<widget name="ce/fileshare/row_2" width="600" height="17" bitmap="server_item_bkds">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="ce/fileshare/row_name"/>
		<child widget="ce/fileshare/row_map"/>
	</widget>
	<widget name="ce/fileshare/row_3" width="600" height="17" bitmap="server_item_bkds">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="ce/fileshare/row_name"/>
		<child widget="ce/fileshare/row_map"/>
	</widget>
	<widget name="ce/fileshare/row_4" width="600" height="17" bitmap="server_item_bkds">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="ce/fileshare/row_name"/>
		<child widget="ce/fileshare/row_map"/>
	</widget>
	<widget name="ce/fileshare/row_5" width="600" height="17" bitmap="server_item_bkds">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="ce/fileshare/row_name"/>
		<child widget="ce/fileshare/row_map"/>
	</widget>
	<widget name="ce/fileshare/row_6" width="600" height="17" bitmap="server_item_bkds">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="ce/fileshare/row_name"/>
		<child widget="ce/fileshare/row_map"/>
	</widget>
	<widget name="ce/fileshare/row_7" width="600" height="17" bitmap="server_item_bkds">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="ce/fileshare/row_name"/>
		<child widget="ce/fileshare/row_map"/>
	</widget>
	<widget name="ce/fileshare/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port fileshare focus"/>
		<on event="left_trigger" run="port fileshare page up"/>
		<on event="right_trigger" run="port fileshare page down"/>
		<on event="left" run="port fileshare kind"/>
		<on event="right" run="port fileshare kind"/>
		<on event="x" run="port fileshare rename"/>
		<on event="y" open="ce/fileshare/delete/screen" run="port fileshare ask delete"/>
		<data input="port fileshare"/>
		<child widget="ce/fileshare/row_0" x="0" y="0"/>
		<child widget="ce/fileshare/row_1" x="0" y="18"/>
		<child widget="ce/fileshare/row_2" x="0" y="36"/>
		<child widget="ce/fileshare/row_3" x="0" y="54"/>
		<child widget="ce/fileshare/row_4" x="0" y="72"/>
		<child widget="ce/fileshare/row_5" x="0" y="90"/>
		<child widget="ce/fileshare/row_6" x="0" y="108"/>
		<child widget="ce/fileshare/row_7" x="0" y="126"/>
	</widget>

	<!-- the heading; the kind between the spinners' arrows, the count at the right -->
	<widget name="ce/fileshare/header" left="35" top="11" width="512" height="64" bitmap="ce/fileshare/header_art"/>
	<widget name="ce/fileshare/kind_left" left="24" top="80" width="12" height="16" bitmap="arrow_sm_left"/>
	<widget name="ce/fileshare/kind" type="text" left="56" top="78" width="284" height="20" font="ui\large_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/kind_right" left="38" top="80" width="12" height="16" bitmap="arrow_sm_right"/>
	<widget name="ce/fileshare/count" type="text" left="340" top="80" width="276" height="18" align="right" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<!-- the chosen one: its map's picture, its name, its details, what the last action came to -->
	<widget name="ce/fileshare/picture" left="24" top="254" width="140" height="114" bitmap="h3/mp_maps"/>
	<widget name="ce/fileshare/info_name" type="text" left="180" top="252" width="436" height="24" font="ui\large_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/info_name_small" type="text" left="180" top="254" width="436" height="22" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/info_text" type="text" left="180" top="278" width="436" height="104" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/status" type="text" left="180" top="384" width="436" height="22" font="ui\small_ui" color="#FFCCCCCC" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/blueline" left="24" top="248" width="592" height="2" bitmap="ui\shell\bitmaps\blue"/>
	<!-- the button key, as the Xbox's (X, Y, then B and A where its own are): the map variants'
	actions hidden with game variants (x_butn, rename, y_butn, delete, a_butn, open) -->
	<widget name="ce/fileshare/x_butn" left="40" top="414" width="20" height="25" bitmap="ui\shell\bitmaps\x_butn"/>
	<widget name="ce/fileshare/rename" type="text" left="61" top="414" width="132" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/fileshare_text" string_index="1" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/y_butn" left="196" top="414" width="20" height="25" bitmap="ui\shell\bitmaps\y_butn"/>
	<widget name="ce/fileshare/delete" type="text" left="217" top="414" width="150" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/fileshare_text" string_index="2" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/b_butn" left="371" top="414" width="21" height="26" bitmap="ui\shell\bitmaps\b_butn"/>
	<widget name="ce/fileshare/back" type="text" left="392" top="414" width="86" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/fileshare_text" string_index="3" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/a_butn" left="481" top="414" width="21" height="26" bitmap="ui\shell\bitmaps\a_butn"/>
	<widget name="ce/fileshare/open" type="text" left="502" top="414" width="134" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/fileshare_text" string_index="0" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/screen" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\gradient">
		<on event="created" run="port fileshare init"/>
		<on event="b back" back="true"/>
		<child widget="ce/fileshare/header"/>
		<child widget="ce/fileshare/kind_left"/>
		<child widget="ce/fileshare/kind"/>
		<child widget="ce/fileshare/kind_right"/>
		<child widget="ce/fileshare/count"/>
		<child widget="ce/fileshare/blueline"/>
		<child widget="ce/fileshare/picture"/>
		<child widget="ce/fileshare/info_name"/>
		<child widget="ce/fileshare/info_name_small"/>
		<child widget="ce/fileshare/info_text"/>
		<child widget="ce/fileshare/status"/>
		<child widget="ce/fileshare/x_butn"/>
		<child widget="ce/fileshare/rename"/>
		<child widget="ce/fileshare/y_butn"/>
		<child widget="ce/fileshare/delete"/>
		<child widget="ce/fileshare/b_butn"/>
		<child widget="ce/fileshare/back"/>
		<child widget="ce/fileshare/a_butn"/>
		<child widget="ce/fileshare/open"/>
		<child widget="ce/fileshare/list" x="20" y="100"/>
	</widget>

	<!-- deleting, asked first: the Xbox's question (ui.map's confirm_delete_gametype: the grey over
	     the screen, alert_bkd's box, its large_ui words), its words written by port fileshare
	     question -->
	<widget name="ce/fileshare/delete/title" type="text" left="56" top="160" width="528" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/fileshare_text" string_index="5" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/delete/text" type="text" left="56" top="192" width="528" height="90" font="ui\small_ui" color="#FF2896FF" text_flags="no_focus_test">
		<data input="port fileshare question"/>
	</widget>
	<widget name="ce/fileshare/delete/keys" type="text" left="56" top="283" width="528" height="24" font="ui\large_ui" color="#FF2896FF" string_list="ce/fileshare_text" string_index="6" text_flags="no_focus_test"/>
	<widget name="ce/fileshare/delete/box" left="40" top="150" width="560" height="170" bitmap="ui\shell\bitmaps\alert_bkd">
		<child widget="ce/fileshare/delete/title"/>
		<child widget="ce/fileshare/delete/text"/>
		<child widget="ce/fileshare/delete/keys"/>
	</widget>
	<widget name="ce/fileshare/delete/screen" flags="pass_unhandled_to_focused_child" bitmap="ui\shell\bitmaps\semi_transparent_grey">
		<on event="a" run="port fileshare delete" back="true"/>
		<on event="b back" back="true"/>
		<child widget="ce/fileshare/delete/box"/>
	</widget>
</menus>
