<?xml version="1.0" encoding="UTF-8"?>
<!-- The Halo 3-style MOD MANAGER (the main menu's, beside FILE SHARE): the player's custom content -
the maps folder's maps that are not the Xbox's own and the mods folder's MCC mods - laid out as
Halo 3's file lists: the title strip, the list (name, type, size, ON / OFF / FAILED) in the panel,
the chosen one's facts under it (the modes it plays in, the game's check, what it needs, where it
came from), the buttons in the strip at the foot. Cross turns it off or on (an off one stays in its
folder but leaves the map lists, the bots' playlist and map sharing), Triangle shows its details,
Square deletes it after Halo 3's question. The settings panel's Multiplayer > Modded maps > Mod
manager does the same (port/vita/host/vita_settings.c); both are port/linux/game/mod_manager.c's.
The art is this folder's own (tools/halo3_menu_art.py). -->
<menus>
	<strings name="h3/mods_text">
		<string text="MOD MANAGER"/>
		<string text="NAME"/>
		<string text="TYPE"/>
		<string text="SIZE"/>
		<string text="STATUS"/>
		<string text="Works in"/>
		<string text="Check"/>
		<string text="Needs"/>
		<string text="From"/>
		<string text="Details"/>
		<string text="Delete"/>
		<string text="DELETE"/>
		<string text="YES, DELETE IT"/>
		<string text="NO, KEEP IT"/>
		<string text="Select"/>
		<string text="Off: kept on the memory card, but in no map list. Map variants are in FILE SHARE."/>
	</strings>

	<!-- the list -->
	<widget name="h3/mods/strip" left="0" top="20" width="640" height="36" bitmap="h3/strip"/>
