	<widget name="h3/mods/mods_status" type="text" left="280" top="31" width="336" height="18" align="right" font="h3/font_small" color="#FF9FB6CC" text_y="1"/>
	<widget name="h3/mods/panel" left="16" top="66" width="608" height="262" bitmap="h3/panel"/>
	<widget name="h3/mods/header_name" type="text" left="40" top="70" width="290" height="16" font="h3/font_small" color="#FF9FB6CC" string_list="h3/mods_text" string_index="1"/>
