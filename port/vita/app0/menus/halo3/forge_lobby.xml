<?xml version="1.0" encoding="UTF-8"?>
<!-- The Halo 3-style Forge lobby (the main menu's FORGE): laid out as Halo 3's - the column at the
left (FORGE LOBBY, Network, Map, Extra Objects, START FORGE, Ready, the map's picture with Forge's emblem, "Edit
Objects on <map>"), the nameplate at the right; Map opens a picker as Halo 3's Select Map (the
multiplayer maps in the maps folder, each its picture and description), and the map chosen its
variants, as Halo 3's: the map itself first, then the player's saved map variants of it
(port/linux/src/forge_store.c), each its details; B goes back to the maps. START FORGE starts a
local game of the map in Forge mode (port/linux/game/forge.c), the variant chosen placed as it
starts. Extra Objects chooses the scene packs it brings (other maps' objects: the Covenant's
vehicles, the dropships, the Covenant AI), built in the background while the lobby is open. The maps' pictures and descriptions are ui.map's own, the rest this folder's art. -->
<menus>
	<bitmap name="h3/mp_maps">
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="0"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="1"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="2"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="3"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="4"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="5"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="6"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="7"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="8"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="9"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="10"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="11"/>
		<frame map="ui\shell\bitmaps\mp_map_grafix" index="12"/>
	</bitmap>
	<bitmap name="h3/forge_emblem">
		<frame png="halo3/forge_emblem.png" width="64" height="64"/>
	</bitmap>
	<strings name="h3/forge_text">
		<string text="FORGE LOBBY"/>
		<string text="NETWORK: LOCAL"/>
		<string text="START FORGE"/>
		<string text="Ready"/>
		<string text="This party is local to this PS Vita."/>
		<string text="Select"/>
		<string text="SELECT MAP"/>
		<string text="Leave"/>
		<string text="EXTRA OBJECTS"/>
	</strings>

	<!-- the lobby -->
	<widget name="h3/forge/title" type="text" left="16" top="18" width="240" height="24" font="h3/font_title" color="#FFF2F6FA" text_y="1" string_list="h3/forge_text" string_index="0"/>
	<widget name="h3/forge/network" type="text" left="16" top="49" width="240" height="18" font="h3/font_item" color="#FFC5D0DD" text_y="2" string_list="h3/forge_text" string_index="1"/>
	<widget name="h3/forge/map_row" type="text" width="250" height="20" bitmap="h3/item" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="3">
		<on event="a" open="h3/forge/maps/screen"/>
	</widget>
	<widget name="h3/forge/packs_row" type="text" width="250" height="20" bitmap="h3/item" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="3">
		<on event="a" open="h3/forge/packs/screen"/>
	</widget>
	<widget name="h3/forge/start_row" type="text" width="250" height="20" bitmap="h3/item" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="3" string_list="h3/forge_text" string_index="2">
		<on event="a start" run="port forge start"/>
	</widget>
	<widget name="h3/forge/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="y" open="h3/friends/screen"/>
		<child widget="h3/forge/map_row" x="0" y="0"/>
		<child widget="h3/forge/packs_row" x="0" y="20"/>
		<child widget="h3/forge/start_row" x="0" y="40"/>
	</widget>
	<widget name="h3/forge/rule2" left="8" top="132" width="250" height="2" bitmap="h3/rule"/>
	<widget name="h3/forge/ready" type="text" left="16" top="137" width="240" height="18" font="h3/font_item" color="#FFE6ECF2" text_y="1" string_list="h3/forge_text" string_index="3"/>
	<widget name="h3/forge/ready_sub" type="text" left="16" top="153" width="240" height="16" font="h3/font_small" color="#FF9FB6CC" text_y="1" string_list="h3/forge_text" string_index="4"/>
	<widget name="h3/forge/map_picture" left="16" top="176" width="140" height="114" bitmap="h3/mp_maps"/>
	<widget name="h3/forge/emblem" left="22" top="182" width="64" height="64" bitmap="h3/forge_emblem"/>
	<widget name="h3/forge/caption" type="text" left="16" top="296" width="240" height="20" font="h3/font_item" color="#FFEEF2F6" text_y="1"/>
	<!-- (the variant's words, or why START FORGE did not start: port forge lobby) -->
	<widget name="h3/forge/note" type="text" left="16" top="320" width="240" height="60" font="h3/font_small" color="#FF9FB6CC" text_y="1"/>
	<widget name="h3/forge/a_butn" left="16" top="447" width="16" height="16" bitmap="h3/glyph_cross"/>
	<widget name="h3/forge/select" type="text" left="36" top="446" width="70" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/forge_text" string_index="5"/>
	<widget name="h3/forge/b_butn" left="110" top="447" width="16" height="16" bitmap="h3/glyph_circle"/>
	<widget name="h3/forge/leave" type="text" left="130" top="446" width="70" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/forge_text" string_index="7"/>
	<!-- (scene: its own camera in ui.map's unused new_campaign point, a narrower lens: the ring's
	arc across the planet; in front of it (scene_object=, the menu_monitor and menu_campaign packs)
	343 Guilty Spark behind a Warthog, looking at it) -->
	<widget name="h3/forge/lobby" flags="pass_unhandled_to_focused_child" scene="new_campaign -10 -20 5 40 20 0 40"
		scene_object="menu_campaign:warthog 3.4 0.77 -0.42 235 suspension=0.5;
			menu_monitor:monitor 4.2 0.0 0.22 0 look=1">
		<on event="created" run="port forge lobby init"/>
		<on event="created" run="port h3 scene"/>
		<on event="b back" back="true"/>
		<data input="port forge lobby"/>
		<child widget="h3/main/haze"/>
		<child widget="h3/campaign/column"/>
		<child widget="h3/forge/title"/>
		<child widget="h3/campaign/rule1"/>
		<child widget="h3/forge/network"/>
		<child widget="h3/forge/rule2"/>
		<child widget="h3/forge/ready"/>
		<child widget="h3/forge/ready_sub"/>
		<child widget="h3/forge/map_picture"/>
		<child widget="h3/forge/emblem"/>
		<child widget="h3/forge/caption"/>
		<child widget="h3/forge/note"/>
		<child widget="h3/campaign/rule3"/>
		<child widget="h3/forge/a_butn"/>
		<child widget="h3/forge/select"/>
		<child widget="h3/forge/b_butn"/>
		<child widget="h3/forge/leave"/>
		<child widget="h3/main/players"/>
		<child widget="h3/main/nameplate"/>
		<child widget="h3/friends/lobby_panel"/>
		<child widget="h3/forge/list" x="8" y="70"/>
	</widget>

	<!-- the map picker: Halo 3's Select Map (the list at the left, the picture and its words at the
	right), its items' names written by port forge maps; A on a map shows its variants in the same
	list (port forge map pick: the map itself, then its map variants, twelve and more rows that
	scroll, the triggers a page), A on one of them goes back to the lobby with it, B back to the
	maps (port forge maps back) -->
	<widget name="h3/forge/maps/title" type="text" left="52" top="46" width="400" height="24" font="h3/font_title" color="#FFF2F6FA" text_y="1"/>
	<widget name="h3/forge/maps/item_0" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_1" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_2" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_3" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_4" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_5" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_6" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_7" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_8" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_9" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_10" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_11" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/item_12" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge map pick" back="true"/>
	</widget>
	<widget name="h3/forge/maps/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port forge map focus"/>
		<on event="left_trigger" run="port forge variant page up"/>
		<on event="right_trigger" run="port forge variant page down"/>
		<data input="port forge maps"/>
		<child widget="h3/forge/maps/item_0" y="0"/>
		<child widget="h3/forge/maps/item_1" y="19"/>
		<child widget="h3/forge/maps/item_2" y="38"/>
		<child widget="h3/forge/maps/item_3" y="57"/>
		<child widget="h3/forge/maps/item_4" y="76"/>
		<child widget="h3/forge/maps/item_5" y="95"/>
		<child widget="h3/forge/maps/item_6" y="114"/>
		<child widget="h3/forge/maps/item_7" y="133"/>
		<child widget="h3/forge/maps/item_8" y="152"/>
		<child widget="h3/forge/maps/item_9" y="171"/>
		<child widget="h3/forge/maps/item_10" y="190"/>
		<child widget="h3/forge/maps/item_11" y="209"/>
		<child widget="h3/forge/maps/item_12" y="228"/>
	</widget>
	<widget name="h3/forge/maps/maps_picture" left="320" top="84" width="140" height="114" bitmap="h3/mp_maps"/>
	<widget name="h3/forge/maps/maps_text" type="text" left="320" top="206" width="266" height="120" font="h3/font_small" color="#FFCFD9E3" string_list="ui\shell\main_menu\multiplayer_type_select\mp_map_select\map_data"/>
	<!-- (a variant's details, in the description's place while the variants show) -->
	<widget name="h3/forge/maps/variant_name" type="text" left="320" top="206" width="266" height="20" font="h3/font_item" color="#FFF2F6FA" text_y="1"/>
	<widget name="h3/forge/maps/variant_text" type="text" left="320" top="228" width="266" height="100" font="h3/font_small" color="#FFCFD9E3"/>
	<widget name="h3/forge/maps/screen" flags="pass_unhandled_to_focused_child">
		<on event="b back" run="port forge maps back" back="true"/>
		<child widget="h3/main/haze"/>
		<child widget="h3/pick/panel"/>
		<child widget="h3/forge/maps/title"/>
		<child widget="h3/pick/rule"/>
		<child widget="h3/forge/maps/maps_picture"/>
		<child widget="h3/forge/maps/maps_text"/>
		<child widget="h3/forge/maps/variant_name"/>
		<child widget="h3/forge/maps/variant_text"/>
		<child widget="h3/pick/strip"/>
		<child widget="h3/pick/a_butn"/>
		<child widget="h3/pick/select"/>
		<child widget="h3/pick/b_butn"/>
		<child widget="h3/pick/back"/>
		<child widget="h3/forge/maps/list" x="52" y="84"/>
	</widget>

	<!-- EXTRA OBJECTS: the scene packs Forge brings (port forge packs: each on or off, A to change;
	built in the background from the player's own campaign maps - the Extinction Pelican from the
	player's Halo Custom Edition map Extinction - while the lobby is open, its progress and what
	stops one at the right: "Unavailable: extinction.map (Halo Custom Edition) is not in the maps
	folder") -->
	<widget name="h3/forge/packs/title" type="text" left="52" top="46" width="400" height="24" font="h3/font_title" color="#FFF2F6FA" text_y="1" string_list="h3/forge_text" string_index="8"/>
	<widget name="h3/forge/packs/item_0" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="h3/forge/packs/item_1" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="h3/forge/packs/item_2" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="h3/forge/packs/item_3" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="h3/forge/packs/item_4" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="h3/forge/packs/item_5" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="h3/forge/packs/item_6" type="text" width="250" height="18" bitmap="h3/row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2">
		<on event="a" run="port forge pack toggle"/>
	</widget>
	<widget name="h3/forge/packs/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port forge packs"/>
		<child widget="h3/forge/packs/item_0" y="0"/>
		<child widget="h3/forge/packs/item_1" y="19"/>
		<child widget="h3/forge/packs/item_2" y="38"/>
		<child widget="h3/forge/packs/item_3" y="57"/>
		<child widget="h3/forge/packs/item_4" y="76"/>
		<child widget="h3/forge/packs/item_5" y="95"/>
		<child widget="h3/forge/packs/item_6" y="114"/>
	</widget>
	<widget name="h3/forge/packs/info_name" type="text" left="320" top="84" width="266" height="20" font="h3/font_item" color="#FFF2F6FA" text_y="1"/>
	<widget name="h3/forge/packs/info_text" type="text" left="320" top="106" width="266" height="90" font="h3/font_small" color="#FFCFD9E3"/>
	<widget name="h3/forge/packs/info_state" type="text" left="320" top="200" width="266" height="60" font="h3/font_small" color="#FF9FD8FF"/>
	<widget name="h3/forge/packs/screen" flags="pass_unhandled_to_focused_child">
		<on event="b back" back="true"/>
		<child widget="h3/main/haze"/>
		<child widget="h3/pick/panel"/>
		<child widget="h3/forge/packs/title"/>
		<child widget="h3/pick/rule"/>
		<child widget="h3/forge/packs/info_name"/>
		<child widget="h3/forge/packs/info_text"/>
		<child widget="h3/forge/packs/info_state"/>
		<child widget="h3/pick/strip"/>
		<child widget="h3/pick/a_butn"/>
		<child widget="h3/pick/select"/>
		<child widget="h3/pick/b_butn"/>
		<child widget="h3/pick/back"/>
		<child widget="h3/forge/packs/list" x="52" y="84"/>
	</widget>
</menus>
