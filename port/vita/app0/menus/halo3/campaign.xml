<?xml version="1.0" encoding="UTF-8"?>
<!-- (the game's level pictures are 140x114 in a larger texture: drawn at that size, as the
menus draw a picture 1:1, ui_widget.c draw_bitmap_in_rect) -->
<!-- The Halo 3-style campaign lobby (Menu style Halo 3): it stands for the Xbox's level select,
which the campaign's profile screen opens, and starts the level as its difficulty list does (the
level and the difficulty set, then "main menu switch to solo game"). Laid out as Halo 3's: the
column at the left (CAMPAIGN LOBBY, Network, Mission, Difficulty, Start Game, Ready, the mission's
picture with the difficulty emblem, "<mission> on <difficulty> at Mission Start"), the nameplate
at the right; Network, Mission and Difficulty open pickers as Halo 3's Select Map. Network is
LOCAL (Start Game plays the level here) or co-op, ONLINE CO-OP or SYSTEM LINK CO-OP: Start Game
then hosts the level as the Xbox's difficulty list's Y did (port h3 campaign host), and the
game's lobby, the waiting screen, opens. The level pictures and emblems are ui.map's own, the
rest this folder's art. -->
<menus root="h3/campaign/screen" replaces="ui\shell\main_menu\solo_level_select\solo_level_select_screen">
	<bitmap name="h3/sp_levels">
		<frame map="ui\shell\bitmaps\sp_levels" index="0"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="1"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="2"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="3"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="4"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="5"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="6"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="7"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="8"/>
		<frame map="ui\shell\bitmaps\sp_levels" index="9"/>
	</bitmap>
	<bitmap name="h3/difficulty">
		<frame map="ui\shell\main_menu\difficulty_select\difficulty_options_small" index="0"/>
		<frame map="ui\shell\main_menu\difficulty_select\difficulty_options_small" index="1"/>
		<frame map="ui\shell\main_menu\difficulty_select\difficulty_options_small" index="2"/>
		<frame map="ui\shell\main_menu\difficulty_select\difficulty_options_small" index="3"/>
	</bitmap>
	<bitmap name="h3/row">
		<frame png="halo3/item_off.png" width="128" height="16"/>
		<frame png="halo3/row_on.png" width="128" height="16"/>
	</bitmap>
	<bitmap name="h3/glyph_cross">
		<frame png="halo3/glyph_cross.png" width="16" height="16"/>
	</bitmap>
	<strings name="h3/campaign_text">
		<string text="CAMPAIGN LOBBY"/>
		<string text="NETWORK: LOCAL"/>
		<string text="START GAME"/>
		<string text="Ready"/>
		<string text="This party is local to this PS Vita."/>
		<string text="Select"/>
		<string text="SELECT MISSION"/>
		<string text="SELECT DIFFICULTY"/>
		<string text="SELECT NETWORK"/>
	</strings>
	<strings name="h3/campaign_networks">
		<string text="LOCAL"/>
		<string text="ONLINE CO-OP"/>
		<string text="SYSTEM LINK CO-OP"/>
	</strings>
	<strings name="h3/campaign_network_text">
		<string text="Play the campaign alone on this PS Vita."/>
		<string text="Host co-op on the Internet: others join\nwith your game's code, or from the\nserver browser if you make it public (X\nin the waiting screen). It needs the\nsettings panel's Multiplayer tab,\nConnection: Online."/>
		<string text="Host co-op for the PS Vitas on your\nWi-Fi network (Connection: Same Wi-Fi),\nor near you (Connection: Ad hoc). They\njoin from MULTIPLAYER, BROWSE GAMES."/>
	</strings>
	<strings name="h3/missions">
		<string text="THE PILLAR OF AUTUMN"/>
		<string text="HALO"/>
		<string text="THE TRUTH AND RECONCILIATION"/>
		<string text="THE SILENT CARTOGRAPHER"/>
		<string text="ASSAULT ON THE CONTROL ROOM"/>
		<string text="343 GUILTY SPARK"/>
		<string text="THE LIBRARY"/>
		<string text="TWO BETRAYALS"/>
		<string text="KEYES"/>
		<string text="THE MAW"/>
	</strings>
	<strings name="h3/difficulties">
		<string text="EASY"/>
		<string text="NORMAL"/>
		<string text="HEROIC"/>
		<string text="LEGENDARY"/>
	</strings>
	<strings name="h3/difficulty_text">
		<string text="Your foes are few and slow to react.\nGood for a first look at the story."/>
		<string text="The fight as it was meant to be:\nthe Covenant hold their ground."/>
		<string text="The Covenant are smarter, tougher\nand more numerous. Grunts flee less."/>
		<string text="Every enemy is deadly and relentless.\nOnly the best survive."/>
	</strings>

