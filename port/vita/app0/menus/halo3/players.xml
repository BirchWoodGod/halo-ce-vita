<?xml version="1.0" encoding="UTF-8"?>
<!-- The Halo 3-style PLAYERS screen: the players of the network game this PS Vita plays, the
cursor on a player as on Halo 3's roster, and Cross for the player's options - ADD FRIEND (a friend
request, no code typed: the two machines exchange friend cards over internet play first, only when
the other player has friends on and does not appear offline), INVITE TO PARTY (a friend's player,
p2p_party.h) and BLOCK (port/linux/src/p2p_friends.h,
menu_functions.c "port h3 players ..."). Triangle opens it in the game's lobby (the waiting screen)
and on the carnage report, and with the scoreboard up (Back held) in a game. Listed in menus.txt (the
lobby) and ingame.txt (the scoreboard and the carnage report), so it uses only what both sets have
(the haze, the panel, the strip, the rule, the Cross and Circle icons; its row picture its own).
The art is this folder's own (tools/halo3_menu_art.py). -->
<menus>
	<bitmap name="h3/players_row">
		<frame png="halo3/item_off.png" width="128" height="16"/>
		<frame png="halo3/row_on.png" width="128" height="16"/>
	</bitmap>
	<strings name="h3/players_text">
		<string text="PLAYERS"/>
		<string text="NAME"/>
		<string text="TEAM"/>
		<string text="FRIENDS"/>
		<string text="Options"/>
		<string text="Back"/>
		<string text="ADD FRIEND"/>
		<string text="BLOCK"/>
		<string text="Select"/>
		<string text="INVITE TO PARTY"/>
	</strings>

	<widget name="h3/players/haze" left="0" top="0" width="640" height="480" bitmap="h3/haze"/>
	<widget name="h3/players/strip" left="0" top="20" width="640" height="36" bitmap="h3/strip"/>
	<widget name="h3/players/rule" left="0" top="56" width="640" height="2" bitmap="h3/rule"/>
	<widget name="h3/players/title" type="text" left="28" top="26" width="260" height="26" font="h3/font_title" color="#FFF2F6FA" text_y="1" string_list="h3/players_text" string_index="0"/>
	<widget name="h3/players/players_status" type="text" left="250" top="31" width="366" height="18" align="right" font="h3/font_small" color="#FF9FB6CC" text_y="1"/>
	<widget name="h3/players/panel" left="16" top="66" width="608" height="262" bitmap="h3/panel"/>
	<widget name="h3/players/header_name" type="text" left="40" top="70" width="220" height="16" font="h3/font_small" color="#FF9FB6CC" string_list="h3/players_text" string_index="1"/>
	<widget name="h3/players/header_team" type="text" left="266" top="70" width="100" height="16" font="h3/font_small" color="#FF9FB6CC" string_list="h3/players_text" string_index="2"/>
	<widget name="h3/players/header_friend" type="text" left="380" top="70" width="216" height="16" font="h3/font_small" color="#FF9FB6CC" string_list="h3/players_text" string_index="3"/>
	<widget name="h3/players/row_name" type="text" left="12" top="0" width="234" height="20" font="h3/font_item" color="#FFE6ECF2" text_y="2"/>
	<widget name="h3/players/row_team" type="text" left="246" top="0" width="110" height="20" font="h3/font_small" color="#FFC5D0DD" text_y="3"/>
	<widget name="h3/players/row_state" type="text" left="360" top="0" width="236" height="20" font="h3/font_small" color="#FFAABED6" text_y="3"/>
	<widget name="h3/players/row_1" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_2" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_3" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_4" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_5" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_6" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_7" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_8" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_9" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/row_10" width="600" height="20" bitmap="h3/players_row">
		<on event="a start" run="port h3 players act" open="h3/players/options"/>
		<child widget="h3/players/row_name"/>
		<child widget="h3/players/row_team"/>
		<child widget="h3/players/row_state"/>
	</widget>
	<widget name="h3/players/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port h3 players"/>
		<on event="left_trigger" run="port h3 players page up"/>
		<on event="right_trigger" run="port h3 players page down"/>
		<child widget="h3/players/row_1" x="20" y="92"/>
		<child widget="h3/players/row_2" x="20" y="112"/>
		<child widget="h3/players/row_3" x="20" y="132"/>
		<child widget="h3/players/row_4" x="20" y="152"/>
		<child widget="h3/players/row_5" x="20" y="172"/>
		<child widget="h3/players/row_6" x="20" y="192"/>
		<child widget="h3/players/row_7" x="20" y="212"/>
		<child widget="h3/players/row_8" x="20" y="232"/>
		<child widget="h3/players/row_9" x="20" y="252"/>
		<child widget="h3/players/row_10" x="20" y="272"/>
	</widget>
	<widget name="h3/players/detail" type="text" left="28" top="336" width="590" height="36" font="h3/font_small" color="#FFDDE6F0"/>
	<widget name="h3/players/players_message" type="text" left="28" top="376" width="590" height="56" font="h3/font_small" color="#FFF0D090"/>
	<widget name="h3/players/buttons" left="0" top="440" width="640" height="24" bitmap="h3/strip"/>
	<widget name="h3/players/a_butn" left="24" top="444" width="16" height="16" bitmap="h3/glyph_cross"/>
	<widget name="h3/players/a_label" type="text" left="44" top="443" width="120" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/players_text" string_index="4"/>
	<widget name="h3/players/b_butn" left="532" top="444" width="16" height="16" bitmap="h3/glyph_circle"/>
	<widget name="h3/players/back" type="text" left="552" top="443" width="70" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/players_text" string_index="5"/>
	<widget name="h3/players/screen" flags="pass_unhandled_to_focused_child">
		<on event="created" run="port h3 players init"/>
		<on event="b back" back="true"/>
		<child widget="h3/players/haze"/>
		<child widget="h3/players/strip"/>
		<child widget="h3/players/rule"/>
		<child widget="h3/players/title"/>
		<child widget="h3/players/players_status"/>
		<child widget="h3/players/panel"/>
		<child widget="h3/players/header_name"/>
		<child widget="h3/players/header_team"/>
		<child widget="h3/players/header_friend"/>
		<child widget="h3/players/list"/>
		<child widget="h3/players/detail"/>
		<child widget="h3/players/players_message"/>
		<child widget="h3/players/buttons"/>
		<child widget="h3/players/a_butn"/>
		<child widget="h3/players/a_label"/>
		<child widget="h3/players/b_butn"/>
		<child widget="h3/players/back"/>
	</widget>

	<!-- the player's options: Halo 3's question, ADD FRIEND and BLOCK (hidden for this PS Vita's own
	players), Back first -->
	<widget name="h3/players/options_panel" left="120" top="120" width="400" height="230" bitmap="h3/panel"/>
	<widget name="h3/players/options_title" type="text" left="132" top="126" width="376" height="24" font="h3/font_title" color="#FFF2F6FA" text_y="1"/>
	<widget name="h3/players/options_rule" left="120" top="154" width="400" height="2" bitmap="h3/rule"/>
	<widget name="h3/players/options_text" type="text" left="132" top="162" width="376" height="56" font="h3/font_small" color="#FFCFD9E3"/>
	<widget name="h3/players/option_back" type="text" width="376" height="18" bitmap="h3/players_row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2" string_list="h3/players_text" string_index="5">
		<on event="a" back="true"/>
	</widget>
	<widget name="h3/players/option_add" type="text" width="376" height="18" bitmap="h3/players_row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2" string_list="h3/players_text" string_index="6">
		<on event="a" run="port h3 players option" back="true"/>
	</widget>
	<widget name="h3/players/option_block" type="text" width="376" height="18" bitmap="h3/players_row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2" string_list="h3/players_text" string_index="7">
		<on event="a" run="port h3 players option" back="true"/>
	</widget>
	<!-- (a friend's player, the party's: shown only when they can be invited) -->
	<widget name="h3/players/option_party" type="text" width="376" height="18" bitmap="h3/players_row" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="2" string_list="h3/players_text" string_index="9">
		<on event="a" run="port h3 players option" back="true"/>
	</widget>
	<widget name="h3/players/options_list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port h3 players options"/>
		<child widget="h3/players/option_back" y="0"/>
		<child widget="h3/players/option_add" y="20"/>
		<child widget="h3/players/option_block" y="40"/>
		<child widget="h3/players/option_party" y="60"/>
	</widget>
	<widget name="h3/players/options_strip" left="120" top="330" width="400" height="20" bitmap="h3/strip"/>
	<widget name="h3/players/options_a_butn" left="132" top="332" width="16" height="16" bitmap="h3/glyph_cross"/>
	<widget name="h3/players/options_a_label" type="text" left="152" top="331" width="70" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/players_text" string_index="8"/>
	<widget name="h3/players/options_b_butn" left="226" top="332" width="16" height="16" bitmap="h3/glyph_circle"/>
	<widget name="h3/players/options_back" type="text" left="246" top="331" width="70" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/players_text" string_index="5"/>
	<widget name="h3/players/options" flags="pass_unhandled_to_focused_child">
		<on event="b back" back="true"/>
		<child widget="h3/players/haze"/>
		<child widget="h3/players/options_panel"/>
		<child widget="h3/players/options_title"/>
		<child widget="h3/players/options_rule"/>
		<child widget="h3/players/options_text"/>
		<child widget="h3/players/options_strip"/>
		<child widget="h3/players/options_a_butn"/>
		<child widget="h3/players/options_a_label"/>
		<child widget="h3/players/options_b_butn"/>
		<child widget="h3/players/options_back"/>
		<child widget="h3/players/options_list" x="132" y="250"/>
	</widget>
</menus>
