		<string text="LEAVE GAME?"/>
		<string text="You leave this game and go back to the menus.\nThe others play on without you."/>
		<string text="Leave"/>
		<string text="END GAME?"/>
		<string text="You host this game: it ends for every player\nand everyone goes back to the menus."/>
		<string text="End"/>
		<string text="Back"/>
		<string text="Select"/>
		<string text="ALL SETTINGS"/>
		<string text="Change"/>
