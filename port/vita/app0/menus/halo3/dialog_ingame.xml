<?xml version="1.0" encoding="UTF-8"?>
<!-- The Xbox message boxes of a level's map the Halo 3 dialog stands for while Menu style is
Halo 3 (halo3/dialog.xml's screens; menu_tags.c menu_tags_screen): the errors, the pause
screen's questions (REVERT TO CHECKPOINT, RESTART MISSION; split screen's halves too, and
co-op's QUIT), SAVE AND QUIT's "Saving". A map without one of them (a multiplayer map has no
pause questions) leaves it out. With Menu style Halo CE the Xbox's own open -->
<menus>
	<screen root="h3/dlg/error/screen" replaces="ui\shell\error\error_modal_fullscreen"/>
	<screen root="h3/dlg/notice/screen" replaces="ui\shell\error\error_nonmodal_fullscreen"/>
	<screen root="h3/dlg/half_error/screen" replaces="ui\shell\error\error_modal_halfscreen"/>
	<screen root="h3/dlg/half_notice/screen" replaces="ui\shell\error\error_nonmodal_halfscreen"/>
	<screen root="h3/dlg/abort/screen" replaces="ui\shell\error\error_abort_to_dashboard"/>
	<screen root="h3/dlg/abort_final/screen" replaces="ui\shell\error\error_abort_to_dashboard_you_have_no_choice"/>
	<screen root="h3/dlg/exit/screen" replaces="ui\shell\error\aborting_to_dashboard_please_wait"/>
	<screen root="h3/dlg/revert/screen" replaces="ui\shell\error\confirm_restartatsave_modal_fullscreen"/>
	<screen root="h3/dlg/restart/screen" replaces="ui\shell\error\confirm_restartlevel_modal_fullscreen"/>
	<screen root="h3/dlg/half_revert/screen" replaces="ui\shell\error\confirm_restartatsave_modal_halfscreen"/>
	<screen root="h3/dlg/half_restart/screen" replaces="ui\shell\error\confirm_restartlevel_modal_halfscreen"/>
	<screen root="h3/dlg/half_quit/screen" replaces="ui\shell\error\confirm_quit_modal_halfscreen"/>
	<screen root="h3/dlg/savequit/screen" replaces="ui\shell\error\warning_saving_file_screen_ingame"/>
	<screen root="h3/dlg/saved/screen" replaces="ui\shell\error\warning_saving_file_screen_fakery"/>
</menus>
