<!-- The Halo 3-style GAME TYPES (Menu style Halo 3): it stands for the Xbox's game type list
(ui\shell\main_menu\settings_select\multiplayer_setup\playlist_select\gametype_select_screen, which
the multiplayer lobby's EDIT GAME TYPES opens) and the edit screens it leads to (name, game, the
rules of each game, player, item and indicator options). Its rows are the player's saved game
types (z:\saved\playlists, the files the Xbox's list reads), then the game's own, CREATE NEW GAME
TYPE first: Cross on one opens its options - EDIT, COPY, RENAME, DELETE (the game's own: EDIT and
COPY, which make a game type of the player's) -, Triangle makes a new one from a base (the game's
own), Square deletes one after a question. The editor is laid out as Halo 3's: NAME, GAME, then
its settings in groups (GENERAL, RESPAWN, PLAYER, WEAPONS AND VEHICLES, TEAM and the game's own),
each a screen of rows with their values in ice blue, left and right stepping through the values
the Xbox's spinners offer, the focused row's help under them; SAVE writes it with the game's
functions (playlist_profile_new, playlist_profile_save: the same file, its checksum and name), as
the Xbox's SAVE CHANGES did, and the lobby's GAME, START GAME, online hosting and the Halo CE menus
list it at once (menu_functions.c "port h3 gametype ..."). The art is this folder's own
(tools/halo3_menu_art.py). -->
<menus root="h3/gametypes/screen" replaces="ui\shell\main_menu\settings_select\multiplayer_setup\playlist_select\gametype_select_screen">
	<strings name="h3/gametype_text">
		<string text="GAME TYPES"/>
		<string text="Your game types, then the game's own. Cross: its options."/>
		<string text="Delete"/>
		<string text="New Game Type"/>
		<string text="EDIT"/>
		<string text="COPY"/>
		<string text="RENAME"/>
		<string text="DELETE"/>
		<string text="DELETE GAME TYPE"/>
		<string text="CANCEL"/>
		<string text="CHOOSE A BASE"/>
		<string text="EDIT GAME TYPE"/>
		<string text="SAVE"/>
		<string text="SAVE CHANGES?"/>
		<string text="SAVE CHANGES"/>
		<string text="DISCARD CHANGES"/>
		<string text="Change"/>
		<string text="The game type your new one starts as: its rules, which\nyou then change. The game's own are never changed."/>
	</strings>

