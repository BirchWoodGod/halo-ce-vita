	<strings name="h3/fsfriends_text">
		<string text="SHARING"/>
		<string text="SEND TO A FRIEND"/>
		<string text="Send"/>
		<string text="Download"/>
		<string text="Ask again"/>
		<string text="DOWNLOAD?"/>
		<string text="Select"/>
	</strings>

