<?xml version="1.0" encoding="UTF-8"?>
<!-- The Halo 3-style SELECT PROFILE (halo3/join.xml) for split screen's four-way screen too
(split_screen\4way_profile_select: the multiplayer lobby's START GAME on OFFLINE): the same
plates and functions, going on to split screen's map list as the Xbox's did. Its plates are its own
(their Cross opens that list); the rest is join.xml's. -->
<menus root="h3/join_split/screen" replaces="ui\shell\main_menu\multiplayer_type_select\split_screen\4way_profile_select\4way_start2join_screen">
	<widget name="h3/join_split/slot_1" width="252" height="120" bitmap="h3/column">
		<on event="a start" run="port h3 join a" open="ui\shell\main_menu\multiplayer_type_select\split_screen\splitscreen_map_select_wrapper"/>
		<on event="left stick_left" run="port h3 join previous"/>
		<on event="right stick_right up down" run="port h3 join next"/>
		<on event="b back" run="port h3 join leave" back="true"/>
		<child widget="h3/join/slot_title"/>
		<child widget="h3/join/slot_rule"/>
		<child widget="h3/join/slot_left"/>
		<child widget="h3/join/slot_swatch"/>
		<child widget="h3/join/slot_name"/>
		<child widget="h3/join/slot_right"/>
		<child widget="h3/join/slot_state"/>
	</widget>
	<widget name="h3/join_split/slot_2" width="252" height="120" bitmap="h3/column">
		<on event="a start" run="port h3 join a" open="ui\shell\main_menu\multiplayer_type_select\split_screen\splitscreen_map_select_wrapper"/>
		<on event="left stick_left" run="port h3 join previous"/>
		<on event="right stick_right up down" run="port h3 join next"/>
		<on event="b back" run="port h3 join leave" back="true"/>
		<child widget="h3/join/slot_title"/>
		<child widget="h3/join/slot_rule"/>
		<child widget="h3/join/slot_left"/>
		<child widget="h3/join/slot_swatch"/>
		<child widget="h3/join/slot_name"/>
		<child widget="h3/join/slot_right"/>
		<child widget="h3/join/slot_state"/>
	</widget>
	<widget name="h3/join_split/slot_3" width="252" height="120" bitmap="h3/column">
		<on event="a start" run="port h3 join a" open="ui\shell\main_menu\multiplayer_type_select\split_screen\splitscreen_map_select_wrapper"/>
		<on event="left stick_left" run="port h3 join previous"/>
		<on event="right stick_right up down" run="port h3 join next"/>
		<on event="b back" run="port h3 join leave" back="true"/>
		<child widget="h3/join/slot_title"/>
		<child widget="h3/join/slot_rule"/>
		<child widget="h3/join/slot_left"/>
		<child widget="h3/join/slot_swatch"/>
		<child widget="h3/join/slot_name"/>
		<child widget="h3/join/slot_right"/>
		<child widget="h3/join/slot_state"/>
	</widget>
	<widget name="h3/join_split/slot_4" width="252" height="120" bitmap="h3/column">
		<on event="a start" run="port h3 join a" open="ui\shell\main_menu\multiplayer_type_select\split_screen\splitscreen_map_select_wrapper"/>
		<on event="left stick_left" run="port h3 join previous"/>
		<on event="right stick_right up down" run="port h3 join next"/>
		<on event="b back" run="port h3 join leave" back="true"/>
		<child widget="h3/join/slot_title"/>
		<child widget="h3/join/slot_rule"/>
		<child widget="h3/join/slot_left"/>
		<child widget="h3/join/slot_swatch"/>
		<child widget="h3/join/slot_name"/>
		<child widget="h3/join/slot_right"/>
		<child widget="h3/join/slot_state"/>
	</widget>
	<widget name="h3/join_split/slots" flags="pass_unhandled_to_focused_child no_focused_child pass_unhandled_to_all_children">
		<child widget="h3/join_split/slot_1" x="58" y="118" controller="1"/>
		<child widget="h3/join_split/slot_2" x="330" y="118" controller="2"/>
		<child widget="h3/join_split/slot_3" x="58" y="256" controller="3"/>
		<child widget="h3/join_split/slot_4" x="330" y="256" controller="4"/>
	</widget>
	<widget name="h3/join_split/screen" flags="pass_unhandled_to_focused_child no_focused_child pass_unhandled_to_all_children">
		<on event="created" run="clear multiplayer player joins"/>
		<on event="created" run="port h3 join split screen"/>
		<data input="port h3 join"/>
		<child widget="h3/main/haze"/>
		<child widget="h3/pick/panel"/>
		<child widget="h3/join/title"/>
		<child widget="h3/pick/rule"/>
		<child widget="h3/join/next"/>
		<child widget="h3/pick/strip"/>
		<child widget="h3/pick/a_butn"/>
		<child widget="h3/pick/select"/>
		<child widget="h3/pick/b_butn"/>
		<child widget="h3/pick/back"/>
		<child widget="h3/join/start_butn"/>
		<child widget="h3/join/join"/>
		<child widget="h3/join_split/slots"/>
	</widget>
</menus>
