		<on event="b back" back="true"/>
		<child widget="h3/main/haze"/>
		<child widget="h3/fileshare/delete/panel"/>
		<child widget="h3/fileshare/delete/rule"/>
		<child widget="h3/fileshare/delete/strip"/>
		<child widget="h3/fileshare/delete/title"/>
		<child widget="h3/fileshare/delete/text"/>
		<child widget="h3/fileshare/delete/a_butn"/>
		<child widget="h3/fileshare/delete/delete"/>
		<child widget="h3/fileshare/delete/b_butn"/>
		<child widget="h3/fileshare/delete/back"/>
