<?xml version="1.0" encoding="UTF-8"?>
<!-- The Halo 3-style File Share (the main menu's FILE SHARE): the files this PS Vita keeps, laid
out as Halo 3's - the panel with FILE SHARE, the kind (MAP VARIANTS, GAME VARIANTS: L and R), the
list at the left (each file's name and its map; twelve rows that scroll, the triggers a page) and
the one chosen's details at the right (its map's picture, name, map, objects, author, date). On a
map variant (port/linux/src/forge_store.c): A opens the Forge lobby on its map with it chosen,
Square renames it (the system's keyboard), Triangle deletes it (asked first). Game variants (the
Xbox's game types, as MULTIPLAYER's GAME lists them) are listed only. Sharing with friends comes
with the lobbies (docs/superpowers/specs/2026-10-18-forge-design.md). The maps' pictures are
ui.map's own, the rest this folder's art. -->
<menus>
	<bitmap name="h3/glyph_l">
		<frame png="halo3/glyph_l.png" width="16" height="16"/>
	</bitmap>
	<bitmap name="h3/glyph_r">
		<frame png="halo3/glyph_r.png" width="16" height="16"/>
	</bitmap>
	<strings name="h3/fileshare_text">
		<string text="FILE SHARE"/>
		<string text="Open in Forge"/>
		<string text="Rename"/>
		<string text="Delete"/>
		<string text="Kind"/>
		<string text="DELETE MAP VARIANT?"/>
		<string text="Delete"/>
	</strings>

	<!-- the list: its rows (a name, a map), written by port fileshare -->
	<widget name="h3/fileshare/row_name" type="text" left="8" top="1" width="160" height="17" font="h3/font_item" color="#FFC5D0DD"/>
	<widget name="h3/fileshare/row_map" type="text" left="150" top="2" width="94" height="15" align="right" font="h3/font_small" color="#FF77879A"/>
	<widget name="h3/fileshare/row_0" width="250" height="18" bitmap="h3/row">
		<on event="a" run="port fileshare open" open="h3/forge/lobby"/>
		<child widget="h3/fileshare/row_name"/>
		<child widget="h3/fileshare/row_map"/>
	</widget>
