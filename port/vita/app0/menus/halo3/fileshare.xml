	</widget>
	<widget name="h3/fileshare/title" type="text" left="52" top="46" width="300" height="24" font="h3/font_title" color="#FFF2F6FA" text_y="1" string_list="h3/fileshare_text" string_index="0"/>
	<widget name="h3/fileshare/kind" type="text" left="52" top="78" width="250" height="18" font="h3/font_small" color="#FF9FB6CC" text_y="1"/>
	<widget name="h3/fileshare/count" type="text" left="440" top="50" width="148" height="16" align="right" font="h3/font_small" color="#FF9FB6CC"/>
	<widget name="h3/fileshare/picture" left="320" top="100" width="140" height="114" bitmap="h3/mp_maps"/>
