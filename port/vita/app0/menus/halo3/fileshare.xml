	<widget name="h3/fileshare/info_text" type="text" left="320" top="242" width="266" height="110" font="h3/font_small" color="#FFCFD9E3"/>
	<widget name="h3/fileshare/status" type="text" left="52" top="358" width="536" height="56" font="h3/font_small" color="#FF9FD8FF"/>
	<widget name="h3/fileshare/a_butn" left="52" top="422" width="16" height="16" bitmap="h3/glyph_cross"/>
	<widget name="h3/fileshare/open" type="text" left="72" top="421" width="104" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/fileshare_text" string_index="1"/>
	<widget name="h3/fileshare/x_butn" left="180" top="422" width="16" height="16" bitmap="h3/glyph_square"/>
	<widget name="h3/fileshare/rename" type="text" left="200" top="421" width="70" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/fileshare_text" string_index="2"/>
	<widget name="h3/fileshare/y_butn" left="274" top="422" width="16" height="16" bitmap="h3/glyph_triangle"/>
	<widget name="h3/fileshare/delete" type="text" left="294" top="421" width="62" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/fileshare_text" string_index="3"/>
	<widget name="h3/fileshare/b_butn" left="360" top="422" width="16" height="16" bitmap="h3/glyph_circle"/>
	<widget name="h3/fileshare/back" type="text" left="380" top="421" width="62" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/main_items" string_index="10"/>
	<widget name="h3/fileshare/l_butn" left="500" top="422" width="16" height="16" bitmap="h3/glyph_l"/>
	<widget name="h3/fileshare/r_butn" left="517" top="422" width="16" height="16" bitmap="h3/glyph_r"/>
	<widget name="h3/fileshare/kind_label" type="text" left="536" top="421" width="56" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/fileshare_text" string_index="4"/>
