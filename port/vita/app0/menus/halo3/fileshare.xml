		<child widget="h3/fileshare/row_name"/>
		<child widget="h3/fileshare/row_map"/>
	</widget>
	<widget name="h3/fileshare/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port fileshare focus"/>
		<on event="left_trigger" run="port fileshare page up"/>
		<on event="right_trigger" run="port fileshare page down"/>
		<on event="left" run="port fileshare kind"/>
		<on event="right" run="port fileshare kind"/>
		<on event="x" run="port fileshare rename"/>
		<on event="y" open="h3/fileshare/delete/screen" run="port fileshare ask delete"/>
		<data input="port fileshare"/>
		<child widget="h3/fileshare/row_0" x="0" y="0"/>
		<child widget="h3/fileshare/row_1" x="0" y="19"/>
		<child widget="h3/fileshare/row_2" x="0" y="38"/>
		<child widget="h3/fileshare/row_3" x="0" y="57"/>
		<child widget="h3/fileshare/row_4" x="0" y="76"/>
		<child widget="h3/fileshare/row_5" x="0" y="95"/>
