<?xml version="1.0" encoding="UTF-8"?>
<!-- The Halo 3-style password screen (Menu style Halo 3): it stands for OpenCE's (browser.xml,
pc\join\password\screen), which the server browser opens for a game with a password
(menu_functions.c pc_menu_functions_update), and runs its functions under its names (port password
...): a Halo 3 dialog over the browser's haze. -->
<menus root="h3/password/screen" replaces="pc\join\password\screen">
	<strings name="h3/password_text">
		<string text="ENTER PASSWORD"/>
		<string text="PASSWORD"/>
		<string text="JOIN GAME"/>
	</strings>
	<strings name="h3/password_help">
		<string text=""/>
		<string text="This game has a password. Choose PASSWORD\nto type it, then choose JOIN GAME."/>
		<string text="That is not the game's password. Try again."/>
		<string text="That game is no longer listed."/>
		<string text="Joining..."/>
		<string text=""/>
	</strings>
	<widget name="h3/password/panel" left="120" top="120" width="400" height="220" bitmap="h3/panel"/>
	<widget name="h3/password/title" type="text" left="132" top="126" width="376" height="24" font="h3/font_title" color="#FFF2F6FA" text_y="1" string_list="h3/password_text" string_index="0"/>
	<widget name="h3/password/rule" left="120" top="154" width="400" height="2" bitmap="h3/rule"/>
	<widget name="h3/password/password_game" type="text" left="132" top="162" width="376" height="20" font="h3/font_item" color="#FFE6ECF2" text_y="2"/>
	<widget name="h3/password/password_label" type="text" left="0" top="0" width="150" height="20" font="h3/font_item" color="#FFE6ECF2" text_x="10" text_y="2" string_list="h3/password_text" string_index="1"/>
	<widget name="h3/password/password_value" type="text" left="160" top="0" width="210" height="20" font="h3/font_item" color="#FFAABED6" text_y="2" text_flags="no_focus_test"/>
	<widget name="h3/password/op_password" width="376" height="20" flags="pass_unhandled_to_focused_child" bitmap="h3/row">
		<on event="a start" run="port password edit"/>
		<child widget="h3/password/password_label"/>
		<child widget="h3/password/password_value"/>
	</widget>
	<widget name="h3/password/op_join" type="text" width="376" height="20" bitmap="h3/item" font="h3/font_item" color="#FFF2F6FA" text_x="10" text_y="3" string_list="h3/password_text" string_index="2">
		<on event="a start" run="port password join"/>
	</widget>
	<widget name="h3/password/password_help" type="text" left="132" top="242" width="376" height="70" font="h3/font_small" color="#FFCFD9E3" string_list="h3/password_help"/>
	<widget name="h3/password/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<data input="port password update"/>
		<child widget="h3/password/op_password" x="132" y="188"/>
		<child widget="h3/password/op_join" x="132" y="214"/>
	</widget>
	<widget name="h3/password/strip" left="120" top="320" width="400" height="20" bitmap="h3/strip"/>
	<widget name="h3/password/a_butn" left="132" top="322" width="16" height="16" bitmap="h3/glyph_cross"/>
	<widget name="h3/password/select" type="text" left="152" top="321" width="70" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/campaign_text" string_index="5"/>
	<widget name="h3/password/b_butn" left="226" top="322" width="16" height="16" bitmap="h3/glyph_circle"/>
	<widget name="h3/password/back" type="text" left="246" top="321" width="70" height="18" font="h3/font_item" color="#FFEEF2F6" text_y="1" string_list="h3/main_items" string_index="10"/>
	<widget name="h3/password/screen" flags="pass_unhandled_to_focused_child">
		<on event="deleted" run="port password back"/>
		<child widget="h3/main/haze"/>
		<child widget="h3/password/panel"/>
		<child widget="h3/password/title"/>
		<child widget="h3/password/rule"/>
		<child widget="h3/password/password_game"/>
		<child widget="h3/password/password_help"/>
		<child widget="h3/password/strip"/>
		<child widget="h3/password/a_butn"/>
		<child widget="h3/password/select"/>
		<child widget="h3/password/b_butn"/>
		<child widget="h3/password/back"/>
		<child widget="h3/password/list"/>
	</widget>
</menus>
