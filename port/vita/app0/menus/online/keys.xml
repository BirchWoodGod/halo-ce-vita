		<string text="KEYBOARD &amp; MOUSE"/>
		<string text="This PC's keys and mouse, for every profile. Changes are kept at once."/>
		<string text="SHOW"/>
		<string text="RESET TO MCC DEFAULTS"/>
		<string text="Close"/>
		<string text="Bind"/>
		<string text="Clear"/>
		<string text="Defaults"/>
		<string text="FIRST"/>
		<string text="SECOND"/>
	</strings>
