<?xml version="1.0" encoding="UTF-8"?>
<!-- Menu style Online: the campaign lobby (halo3/campaign.xml's, its scene and its rows) with the
lobbies' SWITCH LOBBY first (menus/online/multiplayer.xml's: CAMPAIGN, MULTIPLAYER, FORGE beside it,
each its words at the right; menu_functions.c online_switch_update), so the rows are SWITCH LOBBY,
HOST SETTINGS, MISSION, DIFFICULTY, START GAME; what is under them moved down a row. HOST SETTINGS
(the other lobbies' row: menus/online/host.xml, its co-op rows) in NETWORK's place, the
connection's status beside it as the other lobbies show it. It stands for h3/campaign/screen in
the Online style (menu_tags.c: online/ for h3/). -->
<menus>
	<widget name="online/campaign/switch_0" type="text" width="176" height="18" bitmap="online/item" font="online/font_item" color="#FFF0F4F8" text_x="8" text_y="2" string_list="online/lobby_text" string_index="3">
		<on event="a start" run="port online switch multiplayer"/>
	</widget>
	<widget name="online/campaign/switch_1" type="text" width="176" height="18" bitmap="online/item" font="online/font_item" color="#FFF0F4F8" text_x="8" text_y="2" string_list="online/lobby_text" string_index="4">
		<on event="a start" run="port online switch forge"/>
	</widget>
	<widget name="online/campaign/switch_2" type="text" width="176" height="18" bitmap="online/item" font="online/font_item" color="#FFF0F4F8" text_x="8" text_y="2" string_list="online/lobby_text" string_index="5">
		<on event="a start" run="port online switch close"/>
	</widget>
	<widget name="online/campaign/switch_panel" left="256" top="51" width="246" height="140" bitmap="online/dropdown"/>
	<widget name="online/campaign/switch_text" type="text" left="262" top="116" width="236" height="80" font="online/font_item" color="#FFF0F4F8" string_list="online/switch_text"/>
	<widget name="online/campaign/switch_row" type="text" width="250" height="20" bitmap="h3/item" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="3" string_list="online/lobby_text" string_index="0">
		<on event="a start" run="port online switch open"/>
	</widget>
	<widget name="online/campaign/host_label" type="text" left="0" top="0" width="130" height="20" font="h3/font_item" color="#FFC5D0DD" text_x="8" text_y="3" string_list="online/lobby_text" string_index="1"/>
	<widget name="online/campaign/network_status" type="text" left="120" top="4" width="122" height="14" font="h3/font_small" color="#FF9FB6CC" align="right">
		<data input="port h3 network status"/>
	</widget>
	<widget name="online/campaign/host_row" width="250" height="20" bitmap="h3/item" flags="pass_unhandled_to_focused_child">
		<on event="a" run="port host campaign" open="online/host/screen"/>
		<child widget="online/campaign/host_label"/>
		<child widget="online/campaign/network_status"/>
	</widget>
	<widget name="online/campaign/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port h3 campaign focus"/>
		<on event="y" open="h3/friends/screen"/>
		<data input="port online switch"/>
		<child widget="online/campaign/switch_2" x="250" y="0"/>
		<child widget="online/campaign/switch_0" x="250" y="20"/>
		<child widget="online/campaign/switch_1" x="250" y="40"/>
		<child widget="online/campaign/switch_row" x="0" y="0"/>
		<child widget="online/campaign/host_row" x="0" y="20"/>
		<child widget="h3/campaign/mission_row" x="0" y="40"/>
		<child widget="h3/campaign/difficulty_row" x="0" y="60"/>
		<child widget="h3/campaign/start_row" x="0" y="80"/>
		<child widget="h3/campaign/start_coop" x="0" y="80"/>
		<child widget="h3/campaign/start_adhoc" x="0" y="80"/>
	</widget>
	<widget name="online/campaign/rule2" left="8" top="166" width="250" height="2" bitmap="h3/rule"/>
	<widget name="online/campaign/ready" type="text" left="16" top="171" width="240" height="18" font="h3/font_item" color="#FFE6ECF2" text_y="1" string_list="h3/campaign_text" string_index="3"/>
	<widget name="online/campaign/ready_sub" type="text" left="16" top="187" width="240" height="16" font="h3/font_small" color="#FF9FB6CC" text_y="1"/>
	<widget name="online/campaign/picture" left="16" top="210" width="140" height="114" bitmap="h3/sp_levels"/>
	<widget name="online/campaign/emblem" left="22" top="216" width="44" height="48" bitmap="h3/difficulty"/>
	<widget name="online/campaign/caption" type="text" left="16" top="330" width="240" height="40" font="h3/font_item" color="#FFEEF2F6" text_y="1"/>
	<widget name="online/campaign/warning" type="text" left="16" top="374" width="240" height="36" font="h3/font_small" color="#FFF0B070" text_y="1"/>

	<widget name="online/campaign/screen" flags="pass_unhandled_to_focused_child" scene="load_campaign -15 5 0 -20 25 0 50"
		backdrop="load_campaign -54.0 -47.0 47.2 102 18 0 70"
		backdrop_object="menu_campaign:warthog 3.6 0.85 0.0 268 pitch=-25 roll=28 level=1;
			menu_campaign:cyborg in=1 seat=driver;
			menu_campaign:marine_armored in=1 seat=gunner;
			menu_campaign:marine_armored in=1 seat=passenger weapon=assault_rifle"
		scene_object="menu_campaign:warthog 4.2 0.82 -0.42 268 pitch=22 roll=14;
			menu_campaign:cyborg in=1 seat=driver;
			menu_campaign:marine_armored in=1 seat=gunner;
			menu_campaign:marine_armored in=1 seat=passenger weapon=assault_rifle">
		<on event="created" run="port h3 campaign init"/>
		<on event="created" run="port h3 scene"/>
		<on event="b back" back="true"/>
		<data input="port h3 campaign"/>
		<child widget="h3/main/haze"/>
		<child widget="h3/campaign/column"/>
		<child widget="h3/campaign/title"/>
		<child widget="h3/campaign/rule1"/>
		<child widget="online/campaign/rule2"/>
		<child widget="online/campaign/ready"/>
		<child widget="online/campaign/ready_sub"/>
		<child widget="online/campaign/picture"/>
		<child widget="online/campaign/emblem"/>
		<child widget="online/campaign/caption"/>
		<child widget="online/campaign/warning"/>
		<child widget="h3/campaign/rule3"/>
		<child widget="h3/campaign/a_butn"/>
		<child widget="h3/campaign/select"/>
		<child widget="h3/campaign/b_butn"/>
		<child widget="h3/campaign/back"/>
		<child widget="h3/main/players"/>
		<child widget="h3/main/nameplate"/>
		<child widget="h3/main/party_plates"/>
		<child widget="h3/friends/lobby_panel"/>
		<child widget="online/campaign/switch_panel"/>
		<child widget="online/campaign/switch_text"/>
		<child widget="online/campaign/list" x="8" y="50"/>
	</widget>
	<!-- (HOST SETTINGS' NETWORK: the co-op networks, halo3/campaign.xml's SELECT NETWORK laid out as
	this folder's pickers, multiplayer.xml's online/network/screen; it stands for h3/campnet/screen) -->
	<widget name="online/campnet/item_0" type="text" width="150" height="17" bitmap="online/item" font="online/font_item" color="#FFF0F4F8" text_x="8" text_y="1" string_list="h3/campaign_networks" string_index="0">
		<on event="a" run="port h3 campaign network set" back="true"/>
	</widget>
	<widget name="online/campnet/item_1" type="text" width="150" height="17" bitmap="online/item" font="online/font_item" color="#FFF0F4F8" text_x="8" text_y="1" string_list="h3/campaign_networks" string_index="1">
		<on event="a" run="port h3 campaign network set" back="true"/>
	</widget>
	<widget name="online/campnet/item_2" type="text" width="150" height="17" bitmap="online/item" font="online/font_item" color="#FFF0F4F8" text_x="8" text_y="1" string_list="h3/campaign_networks" string_index="2">
		<on event="a" run="port h3 campaign network set" back="true"/>
	</widget>
	<widget name="online/campnet/item_3" type="text" width="150" height="17" bitmap="online/item" font="online/font_item" color="#FFF0F4F8" text_x="8" text_y="1" string_list="h3/campaign_networks" string_index="3">
		<on event="a" run="port h3 campaign network set" back="true"/>
	</widget>
	<widget name="online/campnet/list" type="column_list" flags="pass_unhandled_to_focused_child up_down_tabs_items">
		<on event="created" run="port h3 campaign network focus"/>
		<data input="port h3 campaign networks"/>
		<child widget="online/campnet/item_0" y="0"/>
		<child widget="online/campnet/item_1" y="18"/>
		<child widget="online/campnet/item_2" y="36"/>
		<child widget="online/campnet/item_3" y="54"/>
	</widget>
	<widget name="online/campnet/title" type="text" left="2" top="36" width="400" height="34" font="online/font_header" color="#FFF2F6FA" text_y="1" string_list="h3/campaign_text" string_index="8"/>
	<widget name="online/campnet/campnet_text" type="text" left="226" top="88" width="272" height="190" font="online/font_small" color="#FFCFD9E3" string_list="h3/campaign_network_text"/>
	<widget name="online/campnet/screen" flags="pass_unhandled_to_focused_child">
		<on event="b back" back="true"/>
		<child widget="online/pick/dim"/>
		<child widget="online/pick/header"/>
		<child widget="online/pick/foot"/>
		<child widget="online/campnet/title"/>
		<child widget="online/campnet/campnet_text"/>
		<child widget="online/pick/a_butn"/>
		<child widget="online/pick/select"/>
		<child widget="online/pick/b_butn"/>
		<child widget="online/pick/back"/>
		<child widget="online/campnet/list" x="6" y="86"/>
	</widget>
</menus>
